{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "warn",
		"style": "off",
		"pedantic": "off",
		"restriction": "off",
		"nursery": "off"
	},
	"rules": {
		"prefer-const": "error",
		"curly": "error",
		"no-shadow": "error",
		"no-await-in-loop": "off",
		"no-map-spread": "off"
	},
	"env": {
		"browser": true,
		"node": true,
		"es2024": true
	},
	"ignorePatterns": [
		".svelte-kit",
		".wrangler",
		"build",
		"dist",
		"node_modules",
		"static",
		"**/*.svelte",
		"worker-configuration.d.ts",
		"src/lib/server/wfp/templates.generated.ts"
	]
}
